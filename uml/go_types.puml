@startuml
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 16
skinparam nodesep 28
skinparam ranksep 36
hide circle
hide empty members

interface Container <<interface>> {
  +Type() : string
  +Size() : int
  +Values() : []string
  +Clear()
}
interface serializable <<interface>> {
  -appendSerialized(value : string) : error
}
class Array <<struct>> {
  -data : []string
  +PushBack(value : string)
  +Insert(index : int, value : string) : error
  +Erase(index : int) : error
}
class SinglyList <<struct>> {
  -head : *singleNode
  -tail : *singleNode
  -size : int
  +PushBack(value : string)
  +Insert(index : int, value : string) : error
  +Erase(index : int) : error
}
class DoublyList <<struct>> {
  -head : *doubleNode
  -tail : *doubleNode
  -size : int
  +PushBack(value : string)
  +ReverseValues() : []string
  +Erase(index : int) : error
}
class Stack <<struct>> {
  -top : *singleNode
  -size : int
  +Push(value : string)
  +Pop() : (string, error)
  +Top() : (string, error)
}
class Queue <<struct>> {
  -head : *singleNode
  -tail : *singleNode
  -size : int
  +Push(value : string)
  +Pop() : (string, error)
  +Front() : (string, error)
}
class CompleteBinaryTree <<struct>> {
  -root : *treeNode
  -size : int
  +Insert(value : string)
  +Contains(value : string) : bool
  +IsComplete() : bool
}
class OpenHashTable <<struct>> {
  -cells : []hashCell
  -size : int
  -deleted : int
  -doubleHash : bool
  +Set(key : int, value : int)
  +Get(key : int) : (int, bool)
  +Delete(key : int) : bool
}
note right of OpenHashTable
  NewLinearHashTable(capacity)
  NewDoubleHashTable(capacity)
end note

Container <|-- serializable : embeds
serializable <|.. Array
serializable <|.. SinglyList
serializable <|.. DoublyList
serializable <|.. Stack
serializable <|.. Queue
serializable <|.. CompleteBinaryTree
serializable <|.. OpenHashTable

Array -[hidden]down-> Stack
SinglyList -[hidden]down-> Queue
DoublyList -[hidden]down-> CompleteBinaryTree
Queue -[hidden]down-> OpenHashTable
@enduml
